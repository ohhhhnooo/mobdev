<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/black"
    android:orientation="vertical"
    >

    <!-- Математическая операция -->
    <TextView
        android:id="@+id/math_operation"
        android:layout_width="match_parent"
        android:layout_height="120sp"
        android:textColor="#95989c"
        android:textSize="30sp"
        android:layout_gravity="end"
        android:gravity="end|bottom">
    </TextView>

    <!-- Результат -->
    <TextView
        android:id="@+id/result"
        android:layout_width="match_parent"
        android:layout_height="120sp"
        android:textColor="@color/white"
        android:textSize="40sp"
        android:layout_gravity="end"
        android:gravity="end|center_vertical">
    </TextView>

    <!--  Клавиатура  -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="4"
        android:rowCount="5">

        <!--    1 ряд    -->
        <Button
            style="@style/calcButtonLight"
            android:id="@+id/btn_clear"
            android:text="C">
        </Button>

        <Button
            style="@style/calcButtonLight"
            android:id="@+id/btn_change_sign"
            android:text="±">
        </Button>

        <Button
            style="@style/calcButtonLight"
            android:id="@+id/btn_percent"
            android:text="%">
        </Button>

        <Button
            style="@style/calcButtonLight"
            android:id="@+id/btn_divide"
            android:text="÷">
        </Button>

        <!--    2 ряд    -->
        <Button
            style="@style/calcButtonBlack"
            android:id="@+id/btn_7"
            android:text="7">
        </Button>

        <Button
            style="@style/calcButtonBlack"
            android:id="@+id/btn_8"
            android:text="8">
        </Button>

        <Button
            style="@style/calcButtonBlack"
            android:id="@+id/btn_9"
            android:text="9">
        </Button>

        <Button
            style="@style/calcButtonLight"
            android:id="@+id/btn_multiply"
            android:text="×">
        </Button>

        <!--    3 ряд    -->

        <Button
            style="@style/calcButtonBlack"
            android:id="@+id/btn_4"
            android:text="4">
        </Button>

        <Button
            style="@style/calcButtonBlack"
            android:id="@+id/btn_5"
            android:text="5">
        </Button>

        <Button
            style="@style/calcButtonBlack"
            android:id="@+id/btn_6"
            android:text="6">
        </Button>

        <Button
            style="@style/calcButtonLight"
            android:id="@+id/btn_minus"
            android:text="—">
        </Button>

        <!--    4 ряд    -->

        <Button
            style="@style/calcButtonBlack"
            android:id="@+id/btn_1"
            android:text="1">
        </Button>

        <Button
            style="@style/calcButtonBlack"
            android:id="@+id/btn_2"
            android:text="2">
        </Button>

        <Button
            style="@style/calcButtonBlack"
            android:id="@+id/btn_3"
            android:text="3">
        </Button>

        <Button
            style="@style/calcButtonLight"
            android:id="@+id/btn_plus"
            android:text="+">
        </Button>

        <!--    5 ряд    -->

        <Button
            style="@style/calcButtonBlack"
            android:id="@+id/btn_0"
            android:text="0">
        </Button>

        <Button
            style="@style/calcButtonLight"
            android:id="@+id/btn_dot"
            android:text=".">
        </Button>

        <Button
            style="@style/calcButtonLight"
            android:id="@+id/btn_equal"
            android:text="="
            android:layout_columnSpan="2">
        </Button>

    </GridLayout>


</LinearLayout>