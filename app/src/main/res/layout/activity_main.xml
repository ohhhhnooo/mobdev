<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/main"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/black"
    android:orientation="vertical"
    >

    <!-- Математическая операция -->
    <TextView
        android:id="@+id/mathOperation"
        android:layout_width="match_parent"
        android:layout_height="120sp"
        android:textColor="#95989c"
        android:textSize="30sp"
        android:layout_gravity="end"
        android:gravity="end|bottom">
    </TextView>

    <!-- Результат -->
    <TextView
        android:id="@+id/result"
        android:layout_width="match_parent"
        android:layout_height="120sp"
        android:textColor="@color/white"
        android:textSize="40sp"
        android:layout_gravity="end"
        android:gravity="end|center_vertical">
    </TextView>

    <!--  Клавиатура  -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="4"
        android:rowCount="5">

        <!--    1 ряд    -->
        <Button
            style="@style/calcButtonLight"
            android:id="@+id/btnClear"
            android:text="C">
        </Button>

        <Button
            style="@style/calcButtonLight"
            android:id="@+id/btnDelSymbol"
            android:text="&lt;—">
        </Button>

        <Button
            style="@style/calcButtonLight"
            android:id="@+id/btnPercent"
            android:text="%">
        </Button>

        <Button
            style="@style/calcButtonLight"
            android:id="@+id/btnDivide"
            android:text="÷">
        </Button>

        <!--    2 ряд    -->
        <Button
            style="@style/calcButtonBlack"
            android:id="@+id/btn7"
            android:text="7">
        </Button>

        <Button
            style="@style/calcButtonBlack"
            android:id="@+id/btn8"
            android:text="8">
        </Button>

        <Button
            style="@style/calcButtonBlack"
            android:id="@+id/btn9"
            android:text="9">
        </Button>

        <Button
            style="@style/calcButtonLight"
            android:id="@+id/btnMultiply"
            android:text="×">
        </Button>

        <!--    3 ряд    -->

        <Button
            style="@style/calcButtonBlack"
            android:id="@+id/btn4"
            android:text="4">
        </Button>

        <Button
            style="@style/calcButtonBlack"
            android:id="@+id/btn5"
            android:text="5">
        </Button>

        <Button
            style="@style/calcButtonBlack"
            android:id="@+id/btn6"
            android:text="6">
        </Button>

        <Button
            style="@style/calcButtonLight"
            android:id="@+id/btnMinus"
            android:text="—">
        </Button>

        <!--    4 ряд    -->

        <Button
            style="@style/calcButtonBlack"
            android:id="@+id/btn1"
            android:text="1">
        </Button>

        <Button
            style="@style/calcButtonBlack"
            android:id="@+id/btn2"
            android:text="2">
        </Button>

        <Button
            style="@style/calcButtonBlack"
            android:id="@+id/btn3"
            android:text="3">
        </Button>

        <Button
            style="@style/calcButtonLight"
            android:id="@+id/btnPlus"
            android:text="+">
        </Button>

        <!--    5 ряд    -->

        <Button
            style="@style/calcButtonBlack"
            android:id="@+id/btn0"
            android:text="0">
        </Button>

        <Button
            style="@style/calcButtonLight"
            android:id="@+id/btnDot"
            android:text=".">
        </Button>

        <Button
            style="@style/calcButtonLight"
            android:id="@+id/btnEquals"
            android:text="="
            android:layout_columnSpan="2">
        </Button>

    </GridLayout>

</LinearLayout>