<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="calcButtonBase" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textSize">36sp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:layout_margin">10dp</item>
    </style>

    <style name="calcButtonBlack" parent="calcButtonBase">
        <item name="backgroundTint">@color/black</item>
        <item name="strokeColor">#636363</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="calcButtonLight" parent="calcButtonBase">
        <item name="backgroundTint">#9E8ABB</item>
        <item name="android:textColor">@color/black</item>
    </style>

</resources>